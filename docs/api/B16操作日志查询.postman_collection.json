{
  "info": {
    "name": "enterprise-cms B-16 操作日志查询",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "可导入 ApiFox/Postman 的验收集合；不是已执行的人工验收记录。启用 Cookie，填写本机管理员与无日志权限普通账号变量。清空该服务器旧 Cookie 后从头执行。仅登录/退出改变会话，不修改日志或权限。账户密码不得提交到 Git。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/enterprise-cms",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "plainUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "plainPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "from",
      "value": "2026-10-01T00:00:00Z",
      "type": "string"
    },
    {
      "key": "to",
      "value": "2026-10-31T23:59:59.999Z",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 未登录查询返回 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 管理员获取 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 管理员登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"operatorId\", String(pm.response.json().data.userId));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 默认分页与稳定排序",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data=pm.response.json().data;",
              "pm.test(\"默认分页\", function () { pm.expect(data.page).to.eql(1); pm.expect(data.size).to.eql(20); pm.expect(data.records).to.be.an(\"array\"); });",
              "pm.test(\"UTC 与排序\", function () { data.records.forEach(r=>pm.expect(r.createdAt).to.match(/Z$/)); for(let i=1;i<data.records.length;i++){const a=data.records[i-1],b=data.records[i]; pm.expect(Date.parse(a.createdAt)>Date.parse(b.createdAt)||(Date.parse(a.createdAt)===Date.parse(b.createdAt)&&a.id>b.id)).to.eql(true);} });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 组合筛选本次管理员成功登录",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?operatorId={{operatorId}}&module=AUTH&action=LOGIN&result=SUCCESS&size=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data=pm.response.json().data;",
              "pm.test(\"组合筛选\", function () { pm.expect(data.total).to.be.at.least(1); pm.expect(data.records).to.have.lengthOf(1); const r=data.records[0]; pm.expect(String(r.operatorId)).to.eql(pm.collectionVariables.get(\"operatorId\")); pm.expect(r.module).to.eql(\"AUTH\"); pm.expect(r.action).to.eql(\"LOGIN\"); pm.expect(r.result).to.eql(\"SUCCESS\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 UTC 时间范围",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?from={{from}}&to={{to}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"时间边界\",function(){const a=Date.parse(pm.collectionVariables.get(\"from\")),b=Date.parse(pm.collectionVariables.get(\"to\")); pm.response.json().data.records.forEach(r=>{const t=Date.parse(r.createdAt);pm.expect(t>=a&&t<=b).to.eql(true);});});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 空结果",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?module=B16_NO_SUCH_MODULE"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"空集合\",function(){const d=pm.response.json().data;pm.expect(d.total).to.eql(0);pm.expect(d.records).to.eql([]);});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 页大小越界",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?size=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 缺少时区",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?from=2026-10-11T00:00:00"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 时间范围倒置",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?from=2026-10-12T00:00:00Z&to=2026-10-11T00:00:00Z"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 重复筛选参数",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs?module=AUTH&module=ARTICLE"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 刷新管理员 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 管理员退出",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 普通账号获取 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 普通账号登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{plainUsername}}\",\"password\":\"{{plainPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 无权限查询返回 403",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/operation-logs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"权限错误码\",function(){pm.expect(pm.response.json().code).to.eql(\"AUTH_FORBIDDEN\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "17 刷新普通账号 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "18 普通账号退出",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
