{
  "apifoxCli": "1.1",
  "name": "A existing session revoked",
  "info": {
    "name": "A existing session revoked",
    "description": "Local CMS acceptance scenario; supply disposable test variables with --variables. No cloud project export is claimed."
  },
  "item": [
    {
      "id": "cms-content",
      "name": "A existing session revoked",
      "item": [
        {
          "id": "cms-step-1",
          "name": "A-HTTP-13 revoked existing session",
          "metaInfo": {
            "type": "http"
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/articles/{{fixtureArticleId}}/publish",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}"
              },
              {
                "key": "Cookie",
                "value": "{{publisherCookie}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{publisherCsrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"version\": 2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"A-HTTP-13 revoked existing session: status\", function () { pm.expect(pm.response.code).to.eql(403); });",
                  "pm.test('requestId', function () { pm.expect(pm.response.json().requestId).to.eql(pm.environment.get('requestId')); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "environment": {
    "id": 1,
    "name": "Dedicated local CMS",
    "variable": {
      "values": [
        {
          "key": "baseUrl",
          "value": "",
          "type": "string"
        },
        {
          "key": "requestId",
          "value": "",
