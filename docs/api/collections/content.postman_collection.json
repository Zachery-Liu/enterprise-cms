  "item": [
    {
      "name": "获取CSRF令牌（登录后须重取）",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/csrf-token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "现有认证接口。Cookie 使用客户端 Cookie Jar；不导出实际 Cookie。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('统一响应', () => { pm.expect(body.code).to.eql('OK'); pm.expect(body.requestId).to.be.a('string').and.not.empty; });",
              "  pm.collectionVariables.set('csrfToken', body.data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "登录（令牌及Session轮换）",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "description": "现有认证接口。Cookie 使用客户端 Cookie Jar；不导出实际 Cookie。",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('统一响应', () => { pm.expect(body.code).to.eql('OK'); pm.expect(body.requestId).to.be.a('string').and.not.empty; });",
              "  pm.collectionVariables.set('csrfToken', ''); // 登录后先重新获取令牌",
              "}"
            ]
          }
        }
      ]
    },
