{
  "info": {
    "name": "enterprise-cms B-11 用户管理",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "仅在隔离验收环境顺序运行。自动注册一个新的临时普通账号，随后停用并恢复该账号；不删除账号。填写管理员账号密码，启用 Cookie，先清空服务器旧 Cookie。需要管理员拥有 cms:user:read、cms:user:manage。集合已准备，未声称在 ApiFox 人工执行。不要提交填写后的真实凭证。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/enterprise-cms",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetVersion",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 获取注册 CSRF 并生成专用账号",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\",pm.response.json().data.token);",
              "const suffix=Date.now()+\"_\"+Math.floor(Math.random()*100000); pm.collectionVariables.set(\"testUsername\",\"b11_\"+suffix); pm.collectionVariables.set(\"testPassword\",\"B11fixture!\"+suffix); pm.collectionVariables.set(\"targetUserId\",\"\");"
            ]
          }
        }
      ]
    },
    {
      "name": "02 注册本轮临时普通账号",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\",\"password\":\"{{testPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"targetUserId\",String(pm.response.json().data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 未登录查询被拒绝",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 管理员获取 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 管理员登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 登录后刷新 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 查询临时账号与版本",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users?username={{testUsername}}&status=ACTIVE"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const d=pm.response.json().data; pm.test(\"唯一临时账号\",()=>{pm.expect(d.total).to.eql(1);pm.expect(String(d.records[0].id)).to.eql(pm.collectionVariables.get(\"targetUserId\"));pm.expect(d.records[0]).not.to.have.property(\"passwordHash\");});",
              "pm.collectionVariables.set(\"targetVersion\",\"\"); if(d.total===1&&String(d.records[0].id)===pm.collectionVariables.get(\"targetUserId\")) pm.collectionVariables.set(\"targetVersion\",String(d.records[0].version));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 停用临时账号",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{targetUserId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"DISABLED\",\"version\":{{targetVersion}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"targetVersion\",String(pm.response.json().data.version));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 旧版本不能覆盖新状态",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{targetUserId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"ACTIVE\",\"version\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 查询停用状态",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users?username={{testUsername}}&status=DISABLED"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"停用可查询\",()=>pm.expect(pm.response.json().data.total).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 恢复临时账号",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{targetUserId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"ACTIVE\",\"version\":{{targetVersion}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"恢复有效\",()=>pm.expect(pm.response.json().data.status).to.eql(\"ACTIVE\")); if(pm.response.code===200) pm.collectionVariables.set(\"targetVersion\",String(pm.response.json().data.version));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 非法状态被拒绝",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{targetUserId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"DELETED\",\"version\":{{targetVersion}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 页大小上限",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users?size=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 管理员退出",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 普通账号获取 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "16 恢复后的临时账号登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\",\"password\":\"{{testPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 普通账号查询被拒绝",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 普通账号刷新 CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf-token"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "19 普通账号退出",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
