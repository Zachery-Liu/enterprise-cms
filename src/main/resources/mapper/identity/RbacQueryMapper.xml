<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zachery.cms.modules.identity.persistence.mapper.RbacQueryMapper">
    <resultMap id="role" type="com.zachery.cms.modules.identity.role.dto.RoleSummary">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <resultMap id="permission" type="com.zachery.cms.modules.identity.permission.dto.PermissionSummary">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <resultMap id="userRole" type="com.zachery.cms.modules.identity.persistence.projection.UserRoleRow">
        <constructor>
            <arg column="user_id" javaType="java.lang.Long"/>
            <arg column="role_id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <resultMap id="rolePermission" type="com.zachery.cms.modules.identity.persistence.projection.RolePermissionRow">
        <constructor>
            <arg column="role_id" javaType="java.lang.Long"/>
            <arg column="permission_id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!-- Management catalogs include disabled objects so an authorized operator can see their state. -->
    <select id="selectRoles" resultMap="role">
        SELECT id, code, name, description, status
        FROM sys_role WHERE deleted = 0 ORDER BY code, id
    </select>
    <select id="selectRole" resultMap="role">
        SELECT id, code, name, description, status FROM sys_role WHERE id = #{id} AND deleted = 0
    </select>
    <select id="selectPermissions" resultMap="permission">
        SELECT id, code, name, description, status
        FROM sys_permission WHERE deleted = 0 ORDER BY code, id
    </select>

    <!-- Effective associations filter account, role and permission state in SQL. -->
    <select id="selectRolesForUsers" resultMap="userRole">
        SELECT DISTINCT u.id AS user_id, r.id AS role_id, r.code, r.name, r.description, r.status
        FROM sys_user u
        JOIN sys_user_role ur ON ur.user_id = u.id
        JOIN sys_role r ON r.id = ur.role_id
        WHERE u.deleted = 0 AND u.status = 'ACTIVE' AND r.deleted = 0 AND r.status = 'ENABLED'
        <choose>
            <when test="userIds != null and userIds.size() > 0">
                AND u.id IN
                <foreach collection="userIds" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
        ORDER BY u.id, r.code, r.id
    </select>
    <select id="selectPermissionsForRoles" resultMap="rolePermission">
        SELECT DISTINCT r.id AS role_id, p.id AS permission_id, p.code, p.name, p.description, p.status
        FROM sys_role r
        JOIN sys_role_permission rp ON rp.role_id = r.id
        JOIN sys_permission p ON p.id = rp.permission_id
        WHERE r.deleted = 0 AND r.status = 'ENABLED' AND p.deleted = 0 AND p.status = 'ENABLED'
        <choose>
            <when test="roleIds != null and roleIds.size() > 0">
                AND r.id IN
                <foreach collection="roleIds" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
        ORDER BY r.id, p.code, p.id
    </select>
</mapper>
